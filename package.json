{
  "name": "tzabtor",
  "private": true,
  "version": "2.1.0",
  "author": "Tzabar Cohen",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "install:all": "npm install",
    "build": "npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
